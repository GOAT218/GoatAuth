# --- GoatAuth configuration -------------------------------------------------
# Copy this file to `.env` and adjust for your deployment.

# Secret used to sign seller dashboard session cookies (JWT). MUST be changed
# in production. Generate one with:  openssl rand -base64 48
GOATAUTH_SESSION_SECRET="change-me-to-a-long-random-string-please-really"

# Secret used to sign client application session tokens returned by /api/v1/*.
GOATAUTH_APP_TOKEN_SECRET="change-me-too-another-long-random-secret-value"

# Absolute or relative path to the SQLite database file.
GOATAUTH_DB_PATH="./data/goatauth.db"

# Public base URL of this deployment (used in docs/examples).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
