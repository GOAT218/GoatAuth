-- Same drag pattern as GoatAuth / Linoria (PC + mobile).
local function makeDraggable(frame, handle)
	handle.Active = true

	handle.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		local startPos = frame.Position
		local dragStart = input.Position
		local dragging = true
		local changedConn
		local endedConn

		changedConn = UserInputService.InputChanged:Connect(function(change)
			if not dragging then
				return
			end
			if change.UserInputType == Enum.UserInputType.MouseMovement or change.UserInputType == Enum.UserInputType.Touch then
				local delta = change.Position - dragStart
				frame.Position = UDim2.new(
					startPos.X.Scale,
					startPos.X.Offset + delta.X,
					startPos.Y.Scale,
					startPos.Y.Offset + delta.Y
				)
			end
		end)

		endedConn = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				if changedConn then
					changedConn:Disconnect()
				end
				if endedConn then
					endedConn:Disconnect()
				end
			end
		end)
	end)
end

local function formatKeyCheckFailure(result)
	if type(result) ~= "table" then
		return "Could not check key"
	end
	local status = tostring(result.status or "INVALID")
	local message = tostring(result.message or "")
	local labels = {
		INVALID = "Invalid key",
		EXPIRED = "Key expired",
		BLACKLISTED = "Key blacklisted",
		HWID_MISMATCH = "Wrong HWID",
		HWID = "Wrong HWID",
		MISSING_SCRIPTID = "Script misconfigured",
		RATE_LIMITED = "Too many attempts",
	}
	local title = labels[status] or status
	if message ~= "" and not string.find(string.lower(message), string.lower(title), 1, true) then
		return title .. " — " .. message
	end
	if message ~= "" then
		return message
	end
	return title
end

