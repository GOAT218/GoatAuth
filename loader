local function scheduleDismiss()
	dismissToken = dismissToken + 1
	local token = dismissToken
	task.delay(NOTICE_SECONDS, function()
		if token ~= dismissToken or not (gui and gui.Parent and shell) then
			return
		end
		TweenService:Create(shell, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(0, 14, 1, 36),
			BackgroundTransparency = 1,
		}):Play()
		task.wait(0.28)
		if token == dismissToken and gui and gui.Parent then
			gui:Destroy()
			gui = nil
			shell = nil
		end
	end)
end

local function setStatus(title, sub)
	ensureShell()
	titleLabel.Text = tostring(title)
	subLabel.Text = tostring(sub or "")
end

local function readLP(name)
	local env = getgenv and getgenv()
	if env and env[name] ~= nil then
		return env[name]
	end
	if _G and rawget(_G, name) ~= nil then
		return rawget(_G, name)
	end
	local ok, value = pcall(function()
		return getfenv()[name]
	end)
	if ok and value ~= nil then
		return value
	end
	return nil
end

local function formatExpiry(timeLeft)
	timeLeft = tonumber(timeLeft)
	if timeLeft == nil or timeLeft == 0 then
		return "Lifetime"
	end
	if timeLeft < 86400 then
		return string.format("%dh left", math.max(1, math.floor(timeLeft / 3600)))
	end
	return string.format("%dd left", math.floor(timeLeft / 86400))
end

local function showWelcome()
	if welcomeShown then
		return
	end
	welcomeShown = true
	ensureShell()

	local discord = tostring(
		readLP("LP_DISCORD_DISPLAY_NAME")
			or readLP("LP_DISCORD")
			or (cachedAuth and cachedAuth.discordUsername)
			or "user"
	)
	if #discord > 18 then
		discord = string.sub(discord, 1, 17) .. "…"
	end

	local executions = tostring(
		readLP("LP_EXECUTIONS")
			or (cachedAuth and cachedAuth.keyExecutions)
			or "—"
	)
	local expiry = formatExpiry(
		readLP("LP_TIMELEFT")
			or (cachedAuth and cachedAuth.expire)
	)

	titleLabel.Text = "Welcome, " .. discord
	subLabel.Text = expiry .. "  ·  " .. executions .. " runs"
	scheduleDismiss()
end

getgenv().LP_CUSTOM_LOADER = function(stepOrTime)
	if stepOrTime == 1 then
		setStatus("GOAT Hub", "Authenticating…")
	elseif stepOrTime == 2 then
		setStatus("GOAT Hub", "Connecting…")
	else
		setStatus("GOAT Hub", "Authenticated")
		task.defer(showWelcome)
	end
end
LP_CUSTOM_LOADER = getgenv().LP_CUSTOM_LOADER

local function LoadScript()
	local scriptId = Scripts[GameId]
	if not scriptId then
		setStatus("GOAT Hub", "No script for this game")
		return false
	end

	setStatus("GOAT Hub", "Loading…")

	local sdkSuccess, sdk = pcall(function()
		return loadstring(game:HttpGet("https://sdk.luaprot.net/"))()
	end)
	if not sdkSuccess then
		setStatus("GOAT Hub", "SDK failed")
		return false
	end

	sdk.scriptId = scriptId

	local key = lp_key or "x"
	local checkOk, checkResult = pcall(function()
		return sdk:checkKey(key)
	end)
	if checkOk and type(checkResult) == "table" and checkResult.status == "VALID" and checkResult.data then
		cachedAuth = checkResult.data
		showWelcome()
	elseif checkOk and type(checkResult) == "table" then
		setStatus("GOAT Hub", tostring(checkResult.status or "Key check failed"))
	end

	local loadOk = pcall(function()
		sdk:loadScript(key)
	end)
	if not loadOk then
		setStatus("GOAT Hub", "Load failed")
		return false
	end

	showWelcome()
	return true
end

LoadScript()
