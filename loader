local function noticeParent()
	local ok, hui = pcall(function()
		return gethui and gethui()
	end)
	if ok and hui then
		return hui
	end
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if pg then
		return pg
	end
	local cok, core = pcall(function()
		return game:GetService("CoreGui")
	end)
	if cok and core then
		return core
	end
	return LocalPlayer:WaitForChild("PlayerGui")
end

local function scrubOldNotices()
	local parents = {}
	local okHui, hui = pcall(function()
		return gethui and gethui()
	end)
	if okHui and hui then
		table.insert(parents, hui)
	end
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if pg then
		table.insert(parents, pg)
	end
	pcall(function()
		table.insert(parents, game:GetService("CoreGui"))
	end)

	local killNames = {
		GoatAuthNotice = true,
		LuaProtNotification = true,
		LuaProtNotify = true,
		LP_Notification = true,
		LPNotification = true,
	}
	for _, parent in ipairs(parents) do
		for _, child in ipairs(parent:GetChildren()) do
			if killNames[child.Name] or (typeof(child.Name) == "string" and string.find(string.lower(child.Name), "luaprot")) then
				pcall(function()
					child:Destroy()
				end)
			end
		end
	end
end

