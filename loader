local function scheduleDismiss()
	dismissToken = dismissToken + 1
	local token = dismissToken
	task.delay(NOTICE_SECONDS, function()
		if token ~= dismissToken or not (gui and gui.Parent and shell) then
			return
		end
		TweenService:Create(shell, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(0, 14, 1, 36),
			BackgroundTransparency = 1,
		}):Play()
		task.wait(0.28)
		if token == dismissToken and gui and gui.Parent then
			gui:Destroy()
			gui = nil
			shell = nil
		end
	end)
end

