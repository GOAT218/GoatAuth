-- Check if user has lp_key and add to prefix
if lp_key then
    prefix = "local lp_key = '" .. lp_key .. "'\n"
end

prefix = prefix .. [[
-- luaprot initialization
]]

local GameId = game.GameId

local Scripts = {
    [3989768869] = "60887533351036579318", -- TSG
    [5369242581] = "88512928415190764448", -- Dow
    [5995470825] = "48794175449906367489", -- HyperShot
    [6035872082] = "70770555380354344965", -- Rivals
    [6583326485] = "97149832134761200323", -- Groundwars
    [6726637224] = "38051361310081996139", -- StreetLife
    [97314177]   = "89066052075251198843", -- NinjaTycoon
    [5200655965] = "05018654462611029174", -- Project Smash
    [9807649116] = "43582573096609583474", -- Tactical Swat
    [3258873704] = "81982446223044293233"  -- Skywars
}

local function LoadScript()
    local scriptId = Scripts[GameId]
    
    if not scriptId then
        warn("No script ID found for game: " .. GameId)
        return false
    end
    
    local success, result = pcall(function()
        print("Initializing LuaProt loader...")
        print("Game ID: " .. GameId)
        print("Script ID: " .. scriptId)
        
        -- Try to load SDK
        local sdkSuccess, sdk = pcall(function()
            return loadstring(game:HttpGet("https://sdk.luaprot.net/"))()
        end)
        
        if not sdkSuccess then
            error("Failed to load SDK: " .. tostring(sdk))
        end
        
        sdk.scriptId = scriptId
        return sdk:loadScript()
    end)
    
    if success then
        print("Successfully loaded script for game: " .. GameId)
        return true
    else
        warn("Failed to load script: " .. tostring(result))
        print("Full error: " .. tostring(result))
        return false
    end
end

LoadScript()
