local function trim(s)
	return (tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

local function readSavedKey()
	local ok, data = pcall(function()
		if isfile and isfile(KEY_FILE) and readfile then
			return readfile(KEY_FILE)
		end
		return nil
	end)
	if ok and type(data) == "string" then
		data = trim(data)
		if data ~= "" and data ~= "x" then
			return data
		end
	end
	return nil
end

local function clearSavedKey()
	pcall(function()
		if isfile and isfile(KEY_FILE) and delfile then
			delfile(KEY_FILE)
		elseif writefile then
			writefile(KEY_FILE, "")
		end
	end)
end

local function readExistingKey()
	local candidates = {
		type(lp_key) == "string" and lp_key or nil,
		getgenv and getgenv().lp_key,
		_G and rawget(_G, "lp_key"),
		readSavedKey(),
	}
	for _, key in ipairs(candidates) do
		if type(key) == "string" then
			key = trim(key)
			if key ~= "" and key ~= "x" then
				return key
			end
		end
	end
	return nil
end

local function storeKey(key)
	key = trim(key)
	lp_key = key
	if getgenv then
		getgenv().lp_key = key
	end
	_G.lp_key = key
	pcall(function()
		if writefile and key ~= "" then
			writefile(KEY_FILE, key)
		end
	end)
	return key
end

