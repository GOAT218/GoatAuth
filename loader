local function noticeParent()
	local ok, hui = pcall(function()
		return gethui and gethui()
	end)
	if ok and hui then
		return hui
	end
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if pg then
		return pg
	end
	local cok, core = pcall(function()
		return game:GetService("CoreGui")
	end)
	if cok and core then
		return core
	end
	return LocalPlayer:WaitForChild("PlayerGui")
end

local function ensureShell()
	if gui and gui.Parent then
		return
	end

	local parent = noticeParent()
	local old = parent:FindFirstChild("GoatAuthNotice")
	if old then
		old:Destroy()
	end

	gui = Instance.new("ScreenGui")
	gui.Name = "GoatAuthNotice"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 100000
	gui.Parent = parent

	shell = Instance.new("Frame")
