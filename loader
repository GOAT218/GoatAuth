local function LoadScript()
	local scriptId = Scripts[GameId]
	if not scriptId then
		setStatus("GOAT Hub", "No script for this game")
		return false
	end

	local sdkSuccess, sdk = pcall(function()
		return loadstring(game:HttpGet("https://sdk.luaprot.net/"))()
	end)
	if not sdkSuccess then
		setStatus("GOAT Hub", "SDK failed")
		return false
	end

	sdk.scriptId = scriptId

	local function validateKey(key)
		local checkOk, checkResult = pcall(function()
			return sdk:checkKey(key)
		end)
		if checkOk and type(checkResult) == "table" and checkResult.status == "VALID" and checkResult.data then
			cachedAuth = checkResult.data
			return true, checkResult
		end
		if checkOk and type(checkResult) == "table" then
			return false, formatKeyCheckFailure(checkResult)
		end
		return false, "Could not reach LuaProt"
	end

	local key = readExistingKey()
	if key then
		setStatus("GOAT Hub", "Checking key…")
		local ok, passed, detail = pcall(validateKey, key)
		if not (ok and passed) then
			clearSavedKey()
			local reason = (ok and detail) or "Saved key failed — enter a new one"
			key = promptForKey(tostring(reason), key, validateKey)
			if not key then
				return false
			end
		end
	else
		key = promptForKey("No key found — enter yours to continue.", nil, validateKey)
		if not key then
			return false
		end
	end

	storeKey(key)
	showWelcome()
	setStatus("GOAT Hub", "Loading…")

	local loadOk = pcall(function()
		sdk:loadScript(key)
	end)
	if not loadOk then
		setStatus("GOAT Hub", "Load failed")
		return false
	end

	showWelcome()
	return true
end

LoadScript()
