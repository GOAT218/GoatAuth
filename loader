local function readLP(name)
	-- Prefer direct globals (how LuaProt injects them), then getgenv.
	local ok, value = pcall(function()
		return getfenv()[name]
	end)
	if ok and value ~= nil then
		return value
	end
	local env = getgenv and getgenv()
	if env and env[name] ~= nil then
		return env[name]
	end
	if _G and rawget(_G, name) ~= nil then
		return rawget(_G, name)
	end
	return nil
end

local function formatExpiry(timeLeft)
	timeLeft = tonumber(timeLeft)
	if timeLeft == nil or timeLeft == 0 then
		return "Lifetime"
	end
	return os.date("!%Y-%m-%d %H:%M UTC", os.time() + timeLeft)
end

local function showWelcome()
	ensureShell()
	clearDetails()

	local scriptName = tostring(readLP("LP_SCRIPT_NAME") or "GOAT Hub")
	local scriptVersion = tostring(readLP("LP_SCRIPT_VERSION") or "1")
	local discord = tostring(readLP("LP_DISCORD_DISPLAY_NAME") or readLP("LP_DISCORD") or "unknown")
	local executions = tostring(readLP("LP_EXECUTIONS") or "—")
	local sessions = tostring(readLP("LP_SESSION_COUNT") or "—")
	local expiry = formatExpiry(readLP("LP_TIMELEFT"))

	statusLabel.Text = string.format("%s  ·  v%s", scriptName, scriptVersion)

	local divider = Instance.new("Frame")
	divider.LayoutOrder = 0
	divider.Size = UDim2.new(1, 0, 0, 1)
	divider.BackgroundColor3 = Theme.Outline
	divider.BackgroundTransparency = 0.25
	divider.BorderSizePixel = 0
	divider.Parent = detailFolder

	addRow(1, "User", discord)
	addRow(2, "Expires", expiry)
	addRow(3, "Runs", executions)
	addRow(4, "Online", sessions)

	task.delay(NOTICE_SECONDS, function()
		if not (gui and gui.Parent and shell) then
			return
		end
		local info = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		TweenService:Create(shell, info, {
			Position = UDim2.new(0, 14, 1, 20),
			BackgroundTransparency = 1,
		}):Play()
		task.wait(0.4)
		if gui and gui.Parent then
			gui:Destroy()
		end
		gui, shell, statusLabel, detailFolder = nil, nil, nil, nil
	end)
end

--[[
	LuaProt calls this when dashboard notification style is "custom":
	  1 = attempting auth
	  2 = connecting
	  else = auth success, value is elapsed seconds
]]
getgenv().LP_CUSTOM_LOADER = function(stepOrTime)
	if stepOrTime == 1 then
		setStatus("Authenticating…")
	elseif stepOrTime == 2 then
		setStatus("Connecting to LuaProt…")
	else
		-- Auth finished. Runtime vars should be available now.
		local seconds = tonumber(stepOrTime)
		if seconds then
			setStatus(string.format("Authenticated  ·  %.2fs", seconds))
		else
			setStatus("Authenticated")
		end
		task.defer(function()
			task.wait(0.05)
			pcall(showWelcome)
		end)
	end
end
-- Also expose as a plain global for loaders that don't use getgenv.
LP_CUSTOM_LOADER = getgenv().LP_CUSTOM_LOADER

local function LoadScript()
	local scriptId = Scripts[GameId]
	if not scriptId then
		warn("[GOAT] No script ID for GameId " .. tostring(GameId))
		setStatus("No script for this game")
		return false
	end

	local success, result = pcall(function()
		print("[GOAT] LuaProt loader")
		print("[GOAT] GameId:", GameId)
		print("[GOAT] ScriptId:", scriptId)

		local sdkSuccess, sdk = pcall(function()
			return loadstring(game:HttpGet("https://sdk.luaprot.net/"))()
		end)
		if not sdkSuccess then
			error("SDK load failed: " .. tostring(sdk))
		end

		sdk.scriptId = scriptId
		-- LP_CUSTOM_LOADER must already be set (done above) before this call.
		return sdk:loadScript()
	end)

	if success then
		print("[GOAT] Script loaded for", GameId)
		-- Fallback if dashboard style isn't "custom" (LP_CUSTOM_LOADER never fires).
		task.delay(1.25, function()
			if gui and gui.Parent and detailFolder and #detailFolder:GetChildren() == 0 then
				pcall(showWelcome)
			elseif not (gui and gui.Parent) then
				pcall(showWelcome)
			end
		end)
		return true
	end

	warn("[GOAT] Load failed:", result)
	setStatus("Auth / load failed")
	return false
end

LoadScript()
